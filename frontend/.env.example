# Frontend env (Create React App) — only REACT_APP_* vars reach the browser.
# Copy to frontend/.env and restart `npm run client` after every change.
#
# CRA reads env at startup; values are inlined into the bundle.
# In production, X-API-Key would NOT live on the frontend — see homework/M5/README.md.

# Base webhook URL (n8n). For local n8n use http://localhost:5678/webhook
REACT_APP_N8N_WEBHOOK_URL=http://localhost:5678/webhook

# Header Auth value for the n8n webhook (creds: n8n-feature-control-api-key).
# Generate a long random string; the same value must be set in the n8n credential.
REACT_APP_N8N_API_KEY=replace-me-with-strong-random-string
