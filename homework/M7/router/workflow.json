    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const text = $json.body.message || '';\nconst pii = [];\nif (/[\\w.%+-]+@[\\w.-]+\\.[A-Za-z]{2,}/.test(text)) pii.push('EMAIL_ADDRESS');\nif (/\\+?\\d[\\d\\s().-]{7,}\\d/.test(text)) pii.push('PHONE_NUMBER');\nif (/\\b(?:\\d[ -]?){13,16}\\b/.test(text)) pii.push('CREDIT_CARD');\nreturn { json: { ...$json.body, piiEntities: pii, startedAt: Date.now() } };"
      },
