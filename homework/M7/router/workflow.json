    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $json;\n  const meta = $('Set Route + Reason').first().json;   // .first() вместо .item — paired-item после агента рвётся\n  const route = meta.route;\n  const startedAt = meta.startedAt ?? Date.now();\n  const reply = j.output ?? j.text ?? j.reply ?? '';\n  const model = route === 'local' ? 'qwen3.5:4b' : 'openai/gpt-4o-mini (stub: local qwen3.5:4b)';\n  let costUsd = 0.0;\n  if (route !== 'local') { costUsd = Math.ceil(String(reply).length / 4) / 1e6 * 0.6; }\n  let toolsUsed = [];\n  try { const steps = j.intermediateSteps ?? []; toolsUsed = steps.map(s => s?.action?.tool ?? s?.tool).filter(Boolean); } catch (e) {}     \n  return { json: {\n    createdAt: new Date().toISOString(),\n    userId: meta.userId, userName: meta.userName, message: meta.message,\n    piiEntities: meta.piiEntities ?? [], route, reason: meta.reason, model,\n    reply, latencyMs: Date.now() - startedAt, costUsd, toolsUsed, injectionFlag: false\n  } };"
      },
