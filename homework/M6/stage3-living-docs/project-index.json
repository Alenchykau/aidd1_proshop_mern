{
  "name": "proshop_mern (fork)",
  "type": "fullstack-polyglot-monorepo",
  "description": "MERN e-commerce (Brad Traversy proshop) extended with a feature-flags MCP (TS), a project-docs RAG MCP (Python), a feature dashboard, and n8n agentic workflows across course modules M3-M5.",
  "tech_stack": {
    "backend": "Node + Express 4.17 + Mongoose 5.10 (ESM), JWT (jsonwebtoken 8, HS256), bcryptjs, multer 1.4",
    "frontend": "React 16.13 + classic Redux 4 + redux-thunk + react-router-dom v5, CRA 3.4 (Webpack 4)",
    "feature_flags_mcp": "TypeScript + @modelcontextprotocol/sdk + zod + express (stdio + HTTP transports)",
    "project_docs_mcp": "Python 3 + mcp FastMCP, wraps hybrid RAG (BGE-M3 via Ollama + Qdrant + rank-bm25 RRF)",
    "rag_pipeline": "Python 3 (markdown-it-py, tiktoken, ollama, qdrant-client, rank-bm25)",
    "datastores": "MongoDB (app data), Qdrant (RAG vectors), local FS uploads/ (images)"
  },
  "subprojects": {
    "backend": {
      "path": "backend/",
      "description": "Express REST API: products/users/orders/upload + /api/config/paypal. route -> controller -> Mongoose model; no service layer.",
      "entry": "backend/server.js",
      "tech": "Node + Express 4 + Mongoose 5 (ESM)",
      "key_paths": {
        "routes": "backend/routes/",
        "controllers": "backend/controllers/",
        "models": "backend/models/",
        "auth": "backend/middleware/authMiddleware.js",
        "token": "backend/utils/generateToken.js",
        "feature_flags_data": "backend/features.json",
        "feature_flags_reader": "backend/utils/featureFile.js"
      }
    },
    "frontend": {
      "path": "frontend/",
      "description": "CRA SPA (catalog/cart/checkout/orders/admin) + M4 Feature Dashboard. Dev proxies /api/* to 127.0.0.1:5000.",
      "entry": "frontend/src/index.js",
      "tech": "React 16.13 + Redux 4 + RRv5",
      "key_paths": {
        "router": "frontend/src/App.js",
        "store": "frontend/src/store.js",
        "screens": "frontend/src/screens/",
        "actions": "frontend/src/actions/",
        "reducers": "frontend/src/reducers/"
      }
    },
    "mcp-feature-flags": {
      "path": "mcp-feature-flags/",
      "description": "MCP server: the ONLY sanctioned writer of backend/features.json. Enforces dependency-gate + disabled-traffic-lock. Tools: get_feature_info, set_feature_state, adjust_traffic_rollout, list_features.",
      "entry": "mcp-feature-flags/server.ts (build -> dist/server.js)",
      "tech": "TypeScript + MCP SDK + zod + express",
      "key_paths": {
        "source": "mcp-feature-flags/server.ts",
        "spec": "docs/specs/feature-flags-mcp-spec.md"
      }
    },
    "mcp-project-docs": {
      "path": "mcp-project-docs/",
      "description": "MCP server: hybrid RAG search (search_project_docs) over the docs corpus. Reads docs/chunks.jsonl at import.",
      "entry": "mcp-project-docs/server.py",
      "tech": "Python 3 + FastMCP + Qdrant + Ollama + BM25",
      "key_paths": {
        "source": "mcp-project-docs/server.py",
        "retriever": "scripts/rag_query.py",
        "spec": "docs/specs/project-docs-rag-spec.md"
      }
    },
    "rag-pipeline": {
      "path": "scripts/",
      "description": "Python RAG pipeline: chunk -> embed -> query. Builds docs/chunks.jsonl and the Qdrant collection proshop_chunks.",
      "entry": "scripts/build_chunks.py",
      "tech": "Python 3",
      "key_paths": {
        "chunker": "scripts/build_chunks/",
        "embedder": "scripts/embed_chunks.py",
        "query": "scripts/rag_query.py"
      }
    }
  },
  "system_folders": {
    ".claude/": "Agent config: agents/ (mate + n8n + orchestrator definitions), scripts/update_project_index.py, settings.local.json (MCP enablement, hooks).",
    "docs/": "Living docs: adr/ (3 real fork ADRs), architecture/, specs/ (per-module 4-step specs). DATA subtree: project-data/ + chunks.jsonl (RAG corpus — NOT docs).",
    "homework/": "Course deliverables (M5 n8n workflows, M6 audit artifacts). Not production code.",
    "tests/": "pytest suite for the RAG chunking pipeline (scripts/build_chunks).",
    "uploads/": "multer disk storage for product images (ephemeral on Heroku)."
  },
  "root_files": {
    "CLAUDE.md": "Primary AI agent rules (stack, conventions, gotchas, commit rules). READ alongside this index.",
    "DESIGN.md": "M4 design rules for the frontend.",
    "README.md": "Project overview + setup (covers MCP/RAG; has known path drift, see docs-audit).",
    ".mcp.json": "Registers feature-flags (node) and project-docs (python) MCP servers.",
    "package.json": "Root backend scripts (dev/server/seeder/test:backend) + deps.",
    "requirements-rag.txt": "Python deps for the RAG pipeline + pytest.",
    "Procfile": "Heroku: web: node backend/server.js (single process serves API + built SPA)."
  },
  "hard_rules": [
    "ALWAYS read project-index.json FIRST at session start, then CLAUDE.md.",
    "backend/features.json is written ONLY through the feature-flags MCP (it validates dependencies, enforces the disabled-traffic lock, stamps last_modified). NEVER Edit/Write it directly.",
    "docs/chunks.jsonl and docs/project-data/ are RAG runtime data read at import by mcp-project-docs/server.py. Do NOT archive, move, or treat them as documentation.",
    "docs/adr/ holds the 3 real fork ADRs (0001-0003). docs/project-data/adrs/ is synthetic RAG corpus, NOT architectural decisions — do not act on it as policy.",
    "Backend is ESM: relative imports MUST end in .js. The canonical branch is `main`, not master.",
    "Keep project-index.json current via .claude/scripts/update_project_index.py (or the PostToolUse hook) whenever files/folders are added, removed, or renamed."
  ],
  "ai_routing": {
    "feature_flag_status_or_change": "feature-flags MCP (mcp-feature-flags): get_feature_info / list_features for reads; set_feature_state / adjust_traffic_rollout for writes. Do not read backend/features.json directly.",
    "product_docs_architecture_adr_runbook_incident": "project-docs MCP (mcp-project-docs): search_project_docs (hybrid RAG over docs/).",
    "fork_architecture_decisions": "docs/adr/0001-0003 (real). Proposed: ADR-0004 (MCP single-writer), ADR-0005 (authz layer).",
    "module_behavior_and_edge_cases": "docs/specs/*-spec.md (4-step reverse-engineering specs).",
    "code_review_findings": "homework/M6/stage1-code-review/synthesis.md (57 findings, Top-3 fixed in Stage 2)."
  },
